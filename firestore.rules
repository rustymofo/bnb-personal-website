rules_version = '2';

// Single-tenant rules: this project serves exactly one host, so "signed in
// at all" is equivalent to "is the host" (there is only ever one account).
service cloud.firestore {
  match /databases/{database}/documents {

    match /listings/{listingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /bookings/{bookingId} {
      // Anyone can submit a booking request (the public booking form),
      // but only the signed-in host can read the list back or change
      // status - a guest's booking details (name/email/phone) are not
      // publicly readable.
      allow create: if request.resource.data.keys().hasAll(['listingId', 'checkIn', 'checkOut', 'name', 'email', 'phone', 'status'])
                    && request.resource.data.status == 'pending';
      allow read, update, delete: if request.auth != null;
    }
  }
}
