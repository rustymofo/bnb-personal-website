rules_version = '2';
// Pipeline verification comment - confirms the deploy.yml Firestore rules
// deploy step runs end-to-end now that firebase.json/.firebaserc and the
// FIREBASE_SERVICE_ACCOUNT/FIREBASE_PROJECT_ID secrets are configured.
// Retry marker: re-triggering after fixing FIREBASE_PROJECT_ID secret value.

// Single-tenant rules: this project serves exactly one host, so "signed in
// at all" is equivalent to "is the host" (there is only ever one account).
service cloud.firestore {
  match /databases/{database}/documents {

    match /listings/{listingId} {
      allow read: if true;
      allow write: if request.auth != null;

      match /messages/{messageId} {
        // Host-guest inquiry thread for this listing. Only the signed-in
        // host can read/write it for now (dashboard "Messages" tab); a
        // public guest-side inquiry form is a follow-up.
        allow read, write: if request.auth != null;
      }
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /bookings/{bookingId} {
      // Anyone can submit a booking request (the public booking form),
      // but only the signed-in host can read the list back or change
      // status - a guest's booking details (name/email/phone) are not
      // publicly readable.
      allow create: if request.resource.data.keys().hasAll(['listingId', 'checkIn', 'checkOut', 'name', 'email', 'phone', 'status'])
                    && request.resource.data.status == 'pending';
      // A guest who has a specific booking's document id (shown to them as a
      // "confirmation code" after submitting a request) can fetch that one
      // booking to power the public "My trips" lookup - this is a bearer
      // capability, the same tradeoff as an airline confirmation code, and
      // does NOT allow listing/enumerating all bookings, which stays
      // host-only below.
      allow get: if true;
      allow list, update, delete: if request.auth != null;
    }
  }
}
